{
  "manifest_version": 3,
  "name": "Split View",
  "version": "1.0",
  "description": "Splits the two selected tabs, or the current tab and the one to its left, into Chrome's split view.",
  "minimum_chrome_version": "155",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Split Tabs Side by Side"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
