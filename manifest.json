{
  "manifest_version": 3,
  "name": "Split View",
  "version": "1.0",
  "description": "Splits two sites side by side in new windows.",
  "permissions": ["windows", "system.display"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Split Tabs Side by Side"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
